scontrol show job ${SLURM_JOB_ID}
echo "Job started at $(date)"

PFOLDER="."

ATTEMPT_FILE="${PFOLDER}/job_attempt.txt"
if [ ! -f "$ATTEMPT_FILE" ]; then
    echo "1" > "$ATTEMPT_FILE"
fi
RETRY_COUNT=$(cat "$ATTEMPT_FILE")
echo "Current attempt: $RETRY_COUNT"
MAX_ATTEMPTS=5
ATTEMPT_FAILED_ARCHIVE_MARKER=${ATTEMPT_FAILED_ARCHIVE_MARKER:-ATTEMPT_FAILED_ARCHIVE}

is_titan_xp_retry_exempt_output() {
    local out_file=$1
    local basename=${out_file##*/}

    case "$basename" in
        eqnpt_eq.out|md-*.out) return 0 ;;
        *) return 1 ;;
    esac
}

failure_outputs_have_titan_xp() {
    local retry_count=${1:-}
    local out_file archive_dir archive_name archive_key latest_key=""
    local latest_archive_dirs=()

    scan_titan_xp_outputs_in_dir() {
        local search_dir=$1
        local maxdepth=${2:-3}
        local include_archives=${3:-1}
        local out_file
        [[ -d "$search_dir" ]] || return 1

        if [[ "$include_archives" -eq 1 ]]; then
            while IFS= read -r -d '' out_file; do
                if is_titan_xp_retry_exempt_output "$out_file" && grep -Fq "TITAN Xp" "$out_file"; then
                    echo "[INFO] Detected TITAN Xp in ${out_file#./}; not incrementing failure count."
                    return 0
                fi
            done < <(find "$search_dir" -maxdepth "$maxdepth" -type f -name '*.out' -print0 2>/dev/null)
        else
            while IFS= read -r -d '' out_file; do
                if is_titan_xp_retry_exempt_output "$out_file" && grep -Fq "TITAN Xp" "$out_file"; then
                    echo "[INFO] Detected TITAN Xp in ${out_file#./}; not incrementing failure count."
                    return 0
                fi
            done < <(find "$search_dir" -maxdepth "$maxdepth" -type f -name '*.out' ! -path './WRONG_FAIL/*' ! -path '*/WRONG_FAIL/*' -print0 2>/dev/null)
        fi
        return 1
    }

    if [[ -e "$ATTEMPT_FAILED_ARCHIVE_MARKER" ]]; then
        while IFS= read -r archive_dir; do
            [[ -n "$archive_dir" ]] || continue
            if scan_titan_xp_outputs_in_dir "$archive_dir" 3 1; then
                return 0
            fi
        done < "$ATTEMPT_FAILED_ARCHIVE_MARKER"
        return 1
    fi

    for archive_dir in WRONG_FAIL/*_job_attempt_${retry_count} */WRONG_FAIL/*_job_attempt_${retry_count}; do
        [[ -d "$archive_dir" ]] || continue
        archive_name=${archive_dir##*/}
        archive_key=${archive_name%_job_attempt_${retry_count}}
        if [[ -z "$latest_key" || "$archive_key" > "$latest_key" ]]; then
            latest_key=$archive_key
            latest_archive_dirs=("$archive_dir")
        elif [[ "$archive_key" == "$latest_key" ]]; then
            latest_archive_dirs+=("$archive_dir")
        fi
    done

    if (( ${#latest_archive_dirs[@]} > 0 )); then
        for archive_dir in "${latest_archive_dirs[@]}"; do
            if scan_titan_xp_outputs_in_dir "$archive_dir" 3 1; then
                return 0
            fi
        done
        return 1
    fi

    scan_titan_xp_outputs_in_dir "." 3 0
}

echo "Attempt $RETRY_COUNT to run simulations..."
RETRY=$RETRY_COUNT bash ./run-local-remd.bash
error_code=$?

if [ $error_code -eq 0 ]; then
    echo "Simulation completed successfully on attempt $RETRY_COUNT."
else
    echo "Simulation failed with error code $error_code on attempt $RETRY_COUNT."

    if failure_outputs_have_titan_xp "$RETRY_COUNT"; then
        echo "FAILED" > "${PFOLDER}/ATTEMPT_FAILED"
        echo "Retrying attempt $RETRY_COUNT without incrementing job_attempt.txt because TITAN Xp was used."
        exit 0
    fi

    if [ $RETRY_COUNT -lt $MAX_ATTEMPTS ]; then
        echo "FAILED" > "${PFOLDER}/ATTEMPT_FAILED"
        NEXT_RETRY=$((RETRY_COUNT + 1))
        echo "$NEXT_RETRY" > "$ATTEMPT_FILE"
        exit 0
    else
        echo "FAILED" > "${PFOLDER}/FAILED"
        echo "Maximum attempts (${MAX_ATTEMPTS}) reached. Simulation failed."
        exit 1
    fi
fi

if [[ ! -f "${PFOLDER}/FINISHED" ]]; then
    echo "Simulation is not complete."
    exit 0
fi
echo "Job completed at $(date)"
exit 0
